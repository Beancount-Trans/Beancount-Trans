{
  "name": "beancount-trans-panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness bundle: adds a Ledger entry to the left sidebar with quick-start ledger questions that open in a new session.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
